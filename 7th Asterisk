#include <stdio.h>

int main() {
    //TOP HALF (Rows 1 to 3: 1, 3, and 5 asterisks) 
    int row = 0;
    while (row < 3) {
        // 1. Print leading spaces
        int space = 0;
        while (space < (2 - row)) {
            printf(" ");
            space++;
        }

        // 2. Print asterisks
        int col = 0;
        while (col < (2 * row + 1)) {
            printf("*");
            col++;
        }

        printf("\n");
        row++;
    }

    // BOTTOM HALF (Rows 4 and 5: 3 and 1 asterisks) 
    row = 0;
    while (row < 2) {
        // 1. Print leading spaces
        int space = 0;
        while (space < (row + 1)) {
            printf(" ");
            space++;
        }

        // 2. Print asterisks
        int col = 0;
        while (col < (3 - 2 * row)) {
            printf("*");
            col++;
        }

        printf("\n");
        row++;
    }

    return 0;
}
